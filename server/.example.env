# ==============================================================================
# Backend Server Environment Variables Example (.example.env)
# ==============================================================================
NODE_ENV=development
PORT=5001

# PostgreSQL Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=alumni_db
DB_PORT=5432
DB_HOST=localhost

# Prisma Database URLs
# NOT: Kullanıcı/şifre, docker-compose.yml içindeki Postgres ile aynı olmalı
# (kök .env yoksa varsayılan postgres / postgres). Farklıysa migrate "P1000: Authentication failed" verir.
# Local development (connecting to PostgreSQL on localhost:5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alumni_db?schema=public"
# Docker container network URL
DOCKER_DATABASE_URL="postgresql://postgres:postgres@postgres:5432/alumni_db?schema=public"

# JWT Authentication
JWT_SECRET=dev_only_change_me
JWT_EXPIRES_IN=7d

# Client Configuration
CLIENT_URL=http://localhost:3000

