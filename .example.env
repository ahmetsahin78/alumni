# ==============================================================================
# Alumni Tracking System - Environment Variables Template (.example.env)
# Copy this file to .env and adjust credentials as needed:
#   cp .example.env .env
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=5001

# PostgreSQL Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=alumni_db
DB_PORT=5432
DB_HOST=postgres

# Prisma Database Connections
# For local host execution against exposed Docker DB:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alumni_db?schema=public"
# For execution inside Docker Compose network:
DOCKER_DATABASE_URL="postgresql://postgres:postgres@postgres:5432/alumni_db?schema=public"

# JWT Authentication
JWT_SECRET=super_secret_alumni_tracking_jwt_key_2026
JWT_EXPIRES_IN=7d

# Frontend & CORS Configuration
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5001/api

