# System Environment Variables
NODE_ENV=development
PORT=5001

# PostgreSQL Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=alumni_db
DB_PORT=5432
DB_HOST=postgres

# Prisma Database URL
